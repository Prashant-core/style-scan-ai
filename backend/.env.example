# Copy this file to ".env" and fill in your own values.
# NEVER upload the real .env file to GitHub.

APP_NAME=StyleScan AI
ENVIRONMENT=development

# Local development uses a simple file database. No setup needed.
# For the live site, paste your Neon PostgreSQL link here, for example:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./stylescan.db

# Create a strong secret key by running this command in your terminal:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-with-the-generated-key

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Websites allowed to talk to this backend (comma separated)
FRONTEND_URLS=http://localhost:3000

# Free AI keys (the AI features stay switched off until you add them).
# Gemini key: https://aistudio.google.com/apikey
# Groq key:   https://console.groq.com/keys
GEMINI_API_KEY=AQ.Ab8RN6K4loHiB1zYIGvTsmY9UTi10jty1O3APSr4sp_P_Siifg
GROQ_API_KEY=
# Picture editing may need billing on your Gemini account. Change the model here if needed.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image